{
  "name": "israelinsider",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "kv_namespaces": [ { "binding": "STORE", "id": "REPLACE_WITH_KV_NAMESPACE_ID" } ],
  "triggers": { "crons": ["0 * * * *"] }
}
