{
  "name": "israelinsider",
  "keep_vars": true,
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/unsubscribe*"] },
  "kv_namespaces": [ { "binding": "STORE", "id": "6c698f70d00b4ede8c81b924bc2f50e2" } ],
  "routes": [ { "pattern": "israelinsider.org", "custom_domain": true }, { "pattern": "www.israelinsider.org", "custom_domain": true } ],
  "triggers": { "crons": ["0 * * * *"] }
}
